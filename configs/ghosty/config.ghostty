# ==============================
# Font
# ==============================

font-family = "JetBrains Mono"
font-size = 14


# ==============================
# Window
# ==============================

# Don't reuse/focus an existing Ghostty instance
gtk-single-instance = false

# Hide Ghostty tab bar completely
window-show-tab-bar = never

# Remove titlebar / window decorations completely
window-decoration = none

# Padding
window-padding-x = 12
window-padding-y = 10


# ==============================
# Appearance / Transparency
# ==============================

background = #1a1b26
foreground = #c0caf5

# Lower = more transparent
background-opacity = 0.8

background-blur = true
background-blur-radius = 80


# ==============================
# Cursor
# ==============================

cursor-style = block
cursor-color = #c0caf5
cursor-text = #1a1b26


# ==============================
# Scrolling / Mouse
# ==============================

# Large scrollback history
scrollback-limit = 100000000

# Keep mouse available for terminal scrolling/selection
mouse-reporting = true

# Always let Shift manipulate selections
mouse-shift-capture = never


# ==============================
# Clipboard / Selection
# ==============================

# Selecting text automatically copies it
copy-on-select = clipboard

# Keep selection highlighted after copying
selection-clear-on-copy = false

selection-background = #33467c
selection-foreground = #c0caf5


# ==============================
# Tokyo Night Palette
# ==============================

# Normal palette
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6

# Bright palette
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5


# ==============================
# Keybindings
# ==============================

# Explicitly create another Ghostty window
keybind = ctrl+shift+n=new_window

